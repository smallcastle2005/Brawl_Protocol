      "x": 1132,
      "y": 508,
      "strokeColor": "#0A0A0A",
      "roughness": 0,
      "opacity": 100,
      "text": "· 满速 = 全长 ÷ 45s ≈ 93.6px/s；初始 180s，过点 +120s",
      "fontSize": 16,
      "fontFamily": 2,
      "createdAt": "2026-11-01T11:49:09.930Z",
      "updatedAt": "2026-11-01T11:49:09.930Z",
      "version": 1
    },
